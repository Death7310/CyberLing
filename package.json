{
  "name": "cyberling",
  "version": "0.1.0",
  "private": true,
  "description": "CyberLing: learn programming languages the way you learn a language, through projects, from zero.",
  "type": "module",
  "scripts": {
    "prepare:pyodide": "node scripts/copy-pyodide.mjs",
    "dev": "npm run prepare:pyodide && vite",
    "build": "npm run prepare:pyodide && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "build:artifact": "npm run prepare:pyodide && CYBERLING_TARGET=artifact vite build && node scripts/postbuild-artifact.mjs",
    "test": "vitest run",
    "content:check": "vitest run tests/content.test.ts",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "desktop:preview": "npm run build && vite preview --host",
    "desktop:dev": "npm run build:artifact && electron .",
    "desktop:pack": "npm run build:artifact && electron-builder --dir",
    "desktop:dist": "npm run build:artifact && electron-builder --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.4",
    "codemirror": "^6.0.2",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "main": "desktop/main.mjs",
  "author": "CyberLing contributors",
  "build": {
    "appId": "dev.cyberling.app",
    "productName": "CyberLing",
    "copyright": "CyberLing contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-artifact",
        "to": "web"
      }
    ],
    "npmRebuild": false,
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
